# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=288606663251
ENVIRONMENT=dev
USE_LOCAL_MODE=false
AUTH_ENABLED=false
AUTH_SECRET_KEY=replace-with-a-random-secret
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRATION_MINUTES=15
STS_EXTERNAL_ID=breakglass-guardian

# Bedrock Configuration
BEDROCK_AGENT_ID=XXXXXXXXXX
BEDROCK_AGENT_ALIAS_ID=XXXXXXXXXX
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
BEDROCK_GUARDRAIL_ID=XXXXXXXXXX
BEDROCK_GUARDRAIL_VERSION=1

# DynamoDB Tables
DYNAMODB_REQUESTS_TABLE=breakglass-requests-dev
DYNAMODB_APPROVALS_TABLE=breakglass-approvals-dev
DYNAMODB_SESSIONS_TABLE=breakglass-sessions-dev
DYNAMODB_AUDIT_TABLE=breakglass-audit-dev

# Security Configuration
MAX_SESSION_DURATION_MINUTES=120
REQUIRE_APPROVAL_FOR_RISK_LEVEL=MEDIUM
ALLOWED_RESOURCE_TYPES=ec2,s3,lambda,dynamodb,rds
ALLOWED_AWS_ACCOUNTS=288606663251

# Approval Configuration
APPROVAL_EXPIRATION_MINUTES=60
REQUIRE_MFA_FOR_APPROVAL=true
AUTHORIZED_APPROVERS=admin@company.com,security@company.com

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
DEBUG=false

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=365

# Frontend Configuration (for frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000
